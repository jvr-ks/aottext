eLocalif (FileExist(configFileLocal))  configFile := configFileLocal  if (FileExist(configFileHidden))  configFile := configFileHiddeninitGlobalVariables()readConfig()readGuiData()checkDirectories()refreshAllfiles()generateFoldersMenu()generateMainMenu()readInsertable()mainWindow(starthidden)setAOT()setAutosmall()setNoWrap()readLastUsed()OnMessage(0x200, WM_MOUSEMOVE)SetTimer () => disableInhibit(), -3000;------------------------------ disableInhibit ------------------------------disableInhibit(*){  global    inhibit := 0};-------------------------------- getFromAllfiles --------------------------------getFromAllfiles(){  global  local rt    rt := ""  if (allfiles.Length > 0 && wheelPosition <= allfiles.Length){    rt := allfiles[wheelPosition]  } else {    rt := "aot_20000101000000.txt"  }    return rt};------------------------------- WM_MOUSEMOVE -------------------------------WM_MOUSEMOVE(wParam, lParam, *){  global    if (smodeAutoleave && guiMainMode = 2){    NModeAction()    setNoWrap()  }};--------------------------------- readFile ---------------------------------readFile(filepath, filename){  global   local file, newContent  if (filename != "" && FileExist(filepath)){    file := FileOpen(filepath,"r")    actualContent := file.Read()    file.Close()    ;if (StrLen(actualContent) < 2 || !InStr(actualContent, "`n"))    if (!InStr(actualContent, "`n"))      actualContent .= "`n"        guiMainEdit.clearAll()    setTextToGuiMainEdit(actualContent)  } else {    showHintColored("A file " . filepath . " was not found!")  }};------------------------------ refreshAllfiles ------------------------------refreshAllfiles() {  global  local savePathLocal    allfiles := []  savePathLocal := pathToAbsolut(selectedFolder)  Loop Files savePathLocal "*.*" {    allfiles.push(A_LoopFileName)  }  allfilesMaxCount := allfiles.Length    if (allfilesMaxCount == 0){    showHintColored("Directory of saved files is empty!")    wheelPosition := 1    currentFile := ""    wheelPositionSave()  } else {    currentFile := getFromAllfiles()  }};------------------------------- reloadScript -------------------------------reloadScript(*){  global     inhibit := 1  A_Clipboard := clipboardSave    saveConfig()  saveIfChanged()    reload};--------------------------------- errorExit ---------------------------------errorExit(theMsgArr, clp := "") {    msgComplete := ""  for index, element in theMsgArr  {    msgComplete .= element . "`n"  }  MsgBox(msgComplete, "ERROR", 48)    exitFunction()};----------------------------------- Exit -----------------------------------exitFunction(*){  global     inhibit := 1  saveIfChanged()  saveConfig()    A_Clipboard := clipboardSave  guiMain.destroy()    ExitApp 0};----------------------------------------------------------------------------